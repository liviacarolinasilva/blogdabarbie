<%- include('partials/header') %>

<h1>Bem vindo de volta!</h1>

<div id="login">
    <form id="login-form" action="/login" method="POST">

        <% if (erro) { %>
            <p class="erro"><%= erro %></p>
        <% } %>

        <label for="email">E-mail</label><br>
        <input type="email" id="email" name="email" placeholder="voce@gmail.com" required><br>

        <label for="senha">Senha</label><br>
        <input type="password" id="senha" name="senha" placeholder="*****" required><br>

        <button type="submit" id="rosa">Enviar</button>

    </form>
</div>

<%- include('partials/footer') %>