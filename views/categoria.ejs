<%- include('partials/header') %>

<section class="categoria">

    <p class="subtitulo">ESCOLHA SEU PRÓXIMO CAPÍTULO</p>

    <h1>Qual é o seu mood de hoje?</h1>

    <p class="descricao">
        Da passarela ao seu cantinho favorito: encontre histórias que combinam com você.
    </p>

    <div class="categorias">

        <% categorias.forEach(cat => { %>

            <a href="/categoria/<%= cat.id %>"
               class="categoria-card <%= Number(categoriaSelecionada.id) === Number(cat.id) ? 'selecionada' : '' %>">

                <h2><%= cat.nome %></h2>

                <p><%= cat.descricao || 'Descubra histórias desta categoria.' %></p>

                <small><%= cat.total_publicacoes %> histórias</small>

            </a>

        <% }) %>

    </div>

    <section class="publicacoes-categoria">

        <h2>Um toque de <%= categoriaSelecionada.nome %></h2>

        <p>
            <%= publicacoes.length %> histórias selecionadas •
            Categoria: <%= categoriaSelecionada.nome %>
        </p>

        <div class="noticias-categoria">

            <% if (publicacoes.length > 0) { %>

                <% publicacoes.forEach(publicacao => { %>

                    <article>

                        <% if (publicacao.imagem) { %>
                            <img src="/imagem/<%= publicacao.imagem %>"
                                 alt="<%= publicacao.titulo %>">
                        <% } %>

                        <small><%= categoriaSelecionada.nome %></small>

                        <h3><%= publicacao.titulo %></h3>

                        <p><%= publicacao.conteudo %></p>

                        <small>Por <%= publicacao.autor %></small>

                        <div class="curtidas">

                            <button
                                type="button"
                                class="btn-curtir <%= publicacao.usuario_curtiu ? 'curtido' : '' %>"
                                data-id="<%= publicacao.id %>">

                                ♥
                            </button>

                            <span class="total-curtidas">
                                <%= publicacao.total_curtidas %>
                            </span>

                        </div>

                    </article>

                <% }) %>

            <% } else { %>

                <p>Nenhuma publicação encontrada nesta categoria.</p>

            <% } %>

        </div>

    </section>

    <p class="mensagem-final">
        Você viu toda a seleção. Que tal descobrir outro universo?
    </p>

</section>

<script>

document.querySelectorAll('.btn-curtir').forEach(botao => {

    botao.addEventListener('click', async () => {

        const id = botao.dataset.id;

        try {

            const resposta = await fetch(`/publicacoes/${id}/curtir`, {
                method: 'POST'
            });

            const dados = await resposta.json();

            if (!resposta.ok) {
                alert(dados.mensagem);
                return;
            }

            botao.classList.toggle('curtido', dados.curtida);

            botao.nextElementSibling.textContent = dados.total;

        } catch (erro) {

            console.error('Erro ao curtir:', erro);

        }

    });

});

</script>

<%- include('partials/footer') %>