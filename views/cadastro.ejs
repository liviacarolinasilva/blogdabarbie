<%- include('partials/header') %>

<h1>Bem vindo ao cadastro!</h1>
<div id="cadastro">
    <form id="cadastro-form" action="/cadastro" method="POST">
        <% if (erro) { %>
            <p class="erro"><%= erro %></p>
        <% } %>
        <label for="nome">Nome</label><br>
        <input type="text" id="nome" name="nome" placeholder="Seu nome" required><br>
        <label for="email">E-mail</label><br>
        <input type="email" id="email" name="email" placeholder="voce@gmail.com" required><br>
        <label for="senha">Senha</label><br>
        <input type="password" id="senha" name="senha" placeholder="Mínimo 6 caracteres" minlength="6" required><br>
        <button type="submit" id="rosa">Enviar</button>
    </form>
</div>

<%- include('partials/footer') %>